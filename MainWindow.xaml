<Window x:Class="StreamMultiviewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StreamMultiviewer"
        Icon="Assets/StreamMultiviewer.ico"
        Width="760"
        Height="700"
        MinWidth="620"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#10131A">
    <Grid Margin="36">
        <Grid x:Name="ModePanel"
              Width="500"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Stream Multiviewer"
                           Foreground="White"
                           FontSize="30"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,26"
                           Text="Choose how you want to open your games."
                           Foreground="#AAB3C2"
                           FontSize="15" />
                <Button Height="64"
                        Margin="0,0,0,14"
                        Background="#4778E8"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Content="General"
                        Click="GeneralModeButton_Click" />
                <Button Height="64"
                        Background="#252D3B"
                        Foreground="White"
                        BorderBrush="#414C60"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Content="Twitch"
                        Click="TwitchModeButton_Click" />
                <TextBlock Margin="2,12,2,0"
                           Text="Twitch sign-in is saved in Stream Multiviewer and is separate from your Edge or Chrome profile."
                           Foreground="#8994A6"
                           FontSize="12"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="ModeError"
                           Margin="0,16,0,0"
                           Foreground="#FF8E8E"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid x:Name="SetupPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="SetupTitle"
                               Text="Stream Multiviewer"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="SetupDescription"
                               Margin="0,8,0,0"
                               Text="Choose a layout and enter the game page URLs."
                               Foreground="#AAB3C2"
                               FontSize="15" />
                </StackPanel>
                <Button Grid.Column="1"
                        Width="86"
                        Height="36"
                        Margin="14,0,0,0"
                        VerticalAlignment="Top"
                        Background="#252D3B"
                        Foreground="White"
                        BorderBrush="#414C60"
                        Content="Back"
                        Click="BackButton_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,28,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Number of windows"
                               Foreground="#DCE2EC"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Text="2 is centered; 4 and 6 fill the screen."
                               Foreground="#8994A6"
                               FontSize="12" />
                </StackPanel>
                <ComboBox x:Name="LayoutSelector"
                          Grid.Column="1"
                          Height="42"
                          SelectedIndex="0"
                          Background="White"
                          Foreground="#111827"
                          BorderBrush="#343C4B"
                          FontSize="15">
                    <ComboBox.Resources>
                        <Style TargetType="{x:Type ComboBoxItem}">
                            <Setter Property="Background" Value="White" />
                            <Setter Property="Foreground" Value="#111827" />
                            <Setter Property="Padding" Value="10,8" />
                            <Style.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter Property="Background" Value="#355FA8" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#263957" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Resources>
                    <ComboBoxItem Content="2 windows" Tag="2" />
                    <ComboBoxItem Content="4 windows" Tag="4" />
                    <ComboBoxItem Content="6 windows" Tag="6" />
                </ComboBox>
            </Grid>

            <Border Grid.Row="2"
                    Padding="22"
                    Background="#171B24"
                    BorderBrush="#2B3341"
                    BorderThickness="1"
                    CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,16"
                                   Text="Game URLs"
                                   Foreground="White"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <StackPanel x:Name="UrlFieldsPanel" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <TextBlock x:Name="ValidationMessage"
                       Grid.Row="3"
                       Margin="2,14,2,0"
                       Foreground="#FF8E8E"
                       TextWrapping="Wrap" />

            <Button Grid.Row="4"
                    Height="50"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Stretch"
                    Background="#4778E8"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Content="Start Full-Screen View"
                    Click="StartButton_Click" />
        </Grid>
    </Grid>
</Window>
